---
import { tableauProjects } from '../content/projects';
import { germanProjects } from '../content/languages';
import { favouriteBooks, workCategories } from '../content/site';
import '../styles/home.css';
const { german = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const url = (path = '') => `${base}${german ? 'de/' : ''}${path}`;
const t = (en: string, de: string) => german ? de : en;
const projects = tableauProjects.map((project, index) => ({ ...project, ...(german ? germanProjects[index] : {}) }));
const research = [
  { title: t('Arlington town survey', 'Bürgerbefragung in Arlington'), label: 'Envision Arlington · 2025', text: t('Survey development, analysis, and reporting on 3,268 responses.', 'Fragebogenentwicklung, Analyse und Berichterstattung zu 3.268 Antworten.'), path: 'analytics/#town-survey', image: 'town-survey.webp', kind: 'survey' },
  { title: t('CEG outreach experiment', 'CEG: Öffentlichkeitsarbeit'), label: t('Civic engagement · 2024–2026', 'Bürgerbeteiligung · 2024–2026'), text: t('Flyer design, distribution, and analysis of website activity.', 'Flyergestaltung, Verteilung und Analyse der Website-Aktivität.'), path: 'analytics/ceg/', image: 'ceg/flyer.webp', kind: 'flyer' },
  { title: 'Annual Status of Education Report', label: 'Pratham · 2005', text: t('Data analysis for ASER 2005 and national learning research.', 'Datenanalyse für ASER 2005 und landesweite Bildungsforschung.'), path: 'analytics/#aser' },
  { title: 'Akshara Foundation', label: t('Learning & evaluation', 'Lernen & Evaluation'), text: t('Analysis of student learning data in a randomised control trial.', 'Analyse von Lernstandsdaten in einer randomisierten kontrollierten Studie.'), path: 'analytics/#akshara' },
  { title: t('Evolution of Values', 'Entwicklung von Wertvorstellungen'), label: 'Indian Social Institute · 2012', text: t('A pilot study of children’s values using moral-dilemma stories.', 'Eine Pilotstudie zu den Wertvorstellungen von Kindern anhand moralischer Dilemmageschichten.'), path: 'analytics/#isi' },
  { title: t('Reporting Child Sexual Abuse in India', 'Meldung von sexuellem Kindesmissbrauch in Indien'), label: 'London School of Economics · 2009', text: t('Research on reporting child sexual abuse in India.', 'Forschung zur Meldung von sexuellem Kindesmissbrauch in Indien.'), path: 'analytics/#thesis' },
  { title: 'Report Bee', label: t('Stories & community', 'Geschichten & Gemeinschaft'), text: t('An online community for teachers to share their experiences.', 'Eine Online-Community, in der Lehrkräfte ihre Erfahrungen teilen.'), path: 'analytics/#report-bee' },
  { title: t('Kaggle notebooks', 'Kaggle-Notebooks'), label: t('Data analysis · Kaggle', 'Datenanalyse · Kaggle'), text: t('Cyclistic bike-share analysis and a nutrition diary.', 'Analyse von Cyclistic-Fahrradverleihdaten und ein Ernährungstagebuch.'), path: 'analytics/#notebooks' },
];
---
<div class="home-flow">
  <section class="hero home-hero">
    <div class="hero-copy">
      <p class="handwritten">{t('Hi, I’m Monalisa', 'Hallo, ich bin Monalisa')}</p>
      <h1>{t('Data analysis & ', 'Datenanalyse & ')}<br /><em>{t('social research', 'Sozialforschung')}</em></h1>
      <p class="lead">{t('I’m a data analyst and social researcher based in Düsseldorf. Here are some of my projects in data visualization, education research, and community work.', 'Ich bin Datenanalystin und Sozialforscherin in Düsseldorf. Hier finden Sie einige meiner Projekte in Datenvisualisierung, Bildungsforschung und ehrenamtlicher Arbeit.')}</p>
      <div class="actions"><a class="pill-link" href="#work">{t('View my work', 'Meine Arbeit ansehen')} <span aria-hidden="true">↓</span></a><a class="text-link" href={url('about/')}>{t('About me', 'Über mich')} <span aria-hidden="true">↗</span></a></div>
    </div>
    <div class="hero-collage">
      <span class="collage-spark" aria-hidden="true">✳</span>
      <figure class="portrait-note"><img src={`${base}images/portrait.webp`} alt="Monalisa Hota" width="600" height="600" fetchpriority="high" /></figure>
    </div>
  </section>

  <div id="work" class="work-directory" aria-labelledby="work-title">
    <h2 id="work-title">{t('Work & interests', 'Arbeit & Interessen')} <span aria-hidden="true">↘</span></h2>
    <nav class="work-categories" aria-label={t('Work categories', 'Arbeitsbereiche')}>{workCategories.map((category, index) => <a href={`#${category.id}`}><span class="category-number">0{index + 1}</span><span>{german ? category.de : category.en}</span><span class="category-arrow" aria-hidden="true">↓</span></a>)}</nav>
  </div>

  <section id="visualisation" class="flow-section home-work">
    <div class="section-heading"><div><p class="eyebrow">01 / Tableau</p><h2>{t('Data visualization', 'Datenvisualisierung')}</h2></div><a class="text-link" href={url('visualisation/')}>{t('All visualizations', 'Alle Visualisierungen')} <span aria-hidden="true">↗</span></a></div>
    <div class="grid viz-tiles">{projects.map((project, index) => <a class="image-tile home-tile" href={url(`visualisation/#project-${index + 1}`)}><div class={`dashboard-mat mat-${index}`}><img src={`${base}images/${project.image}`} alt={`${t('Dashboard preview', 'Dashboard-Vorschau')}: ${project.title}`} width="736" height="454" loading="lazy" /></div><div class="tile-copy"><p class="eyebrow">{project.category} / Tableau</p><h3>{project.title}</h3><p>{project.description}</p><span class="card-action">{t('View project', 'Projekt ansehen')} <span aria-hidden="true">↗</span></span></div></a>)}</div>
  </section>

  <section id="research" class="flow-section">
    <div class="section-heading"><div><p class="eyebrow">02 / {t('Surveys & studies', 'Befragungen & Studien')}</p><h2>{t('Research &', 'Forschung &')} <em>{t('experiments', 'Experimente')}</em></h2></div><a class="text-link" href={url('analytics/')}>{t('All research projects', 'Alle Forschungsprojekte')} <span aria-hidden="true">↗</span></a></div>
    <div class="research-cards">{research.map((item, index) => <a class:list={['research-card', { 'featured-research': index < 2 }]} href={url(item.path)}>{item.image && <div class={`research-card-image ${item.kind}`}><img src={`${base}images/${item.image}`} alt={item.title} width={index === 0 ? 680 : 1400} height={index === 0 ? 880 : 1082} loading="lazy" /></div>}<div class="research-card-copy"><p class="eyebrow">{item.label}</p><h3>{item.title}</h3><p>{item.text}</p><span class="card-action">{t('Read more', 'Mehr erfahren')} <span aria-hidden="true">↗</span></span></div></a>)}</div>
  </section>

  <section id="creativity" class="flow-section making-section">
    <div class="section-heading"><div><p class="eyebrow">03 / {t('Personal projects', 'Persönliche Projekte')}</p><h2>{t('Problem solving &', 'Problemlösen &')} <em>{t('creativity', 'Kreativität')}</em></h2></div></div>
    <p class="section-description">{t('I taught myself woodworking and built furniture and storage for my home.', 'Ich habe mir Holzarbeiten selbst beigebracht und Möbel und Stauraumlösungen für mein Zuhause gebaut.')}</p>
    <div class="making-grid">
      <a class="making-card wood-card" href={url('woodworking/')}><div class="craft-art wood-art" aria-hidden="true"><span></span><span></span><span></span></div><div><p class="eyebrow">{t('Furniture & storage', 'Möbel & Stauraum')}</p><h3>{t('Woodworking', 'Holzarbeiten')}</h3><p>{t('Cabinets, pull-out units, and bookshelves.', 'Schränke, ausziehbare Elemente und Bücherregale.')}</p><span class="card-action">{t('More about woodworking', 'Mehr über Holzarbeiten')} ↗</span></div></a>
      <a class="making-card garden-card" href={url('creativity/#garden')}><div class="craft-art garden-art" aria-hidden="true"><span>❧</span></div><div><p class="eyebrow">{t('Project notes', 'Projektnotizen')}</p><h3>{t('Garden', 'Garten')}</h3><p>{t('Notes and photos to be added.', 'Notizen und Fotos folgen.')}</p><span class="card-action">{t('Garden notes', 'Gartennotizen')} ↗</span></div></a>
      <a class="making-card repurpose-card" href={url('creativity/#repurpose')}><div class="craft-art repurpose-art" aria-hidden="true">↻</div><div><p class="eyebrow">{t('Reused materials', 'Wiederverwendete Materialien')}</p><h3>{t('Repurpose', 'Wiederverwenden')}</h3><p>{t('Reusing materials in furniture and storage projects.', 'Materialien für Möbel und Stauraumlösungen wiederverwenden.')}</p><span class="card-action">{t('Read more', 'Mehr erfahren')} ↗</span></div></a>
    </div>
  </section>

  <section id="community" class="flow-section community-section">
    <div><p class="eyebrow">04 / {t('Volunteering', 'Ehrenamt')}</p><h2>{t('Community & ', 'Engagement & ')}<br /><em>{t('volunteering', 'Ehrenamt')}</em></h2><p>{t('I’ve worked on civic research in Arlington and helped coordinate support for a refugee family. I also repair donated watches at Oxfam in Düsseldorf.', 'Ich habe an Bürgerforschung in Arlington mitgearbeitet und die Unterstützung einer Flüchtlingsfamilie mitorganisiert. Bei Oxfam in Düsseldorf repariere ich gespendete Uhren.')}</p><a class="text-link" href={url('community/')}>{t('More about my community work', 'Mehr über mein Engagement')} <span aria-hidden="true">↗</span></a></div>
    <div class="community-links">{[t('Civic Engagement Group', 'Civic Engagement Group'), t('Refugee support', 'Unterstützung einer Flüchtlingsfamilie'), 'Oxfam'].map((label, index) => <a href={url(`community/#${['civic', 'refugee', 'oxfam'][index]}`)}><span>0{index + 1}</span><h3>{label}</h3><span aria-hidden="true">↗</span></a>)}</div>
  </section>

  <section id="courses" class="flow-section courses-section">
    <div class="section-heading"><div><p class="eyebrow">05 / {t('Training', 'Weiterbildung')}</p><h2>{t('Courses &', 'Kurse &')} <em>{t('certificates', 'Zertifikate')}</em></h2></div></div>
    <div class="course-list">
      <a class="course-card" href={url('courses/#google-data-analytics')}><span class="course-symbol" aria-hidden="true">✺</span><div><p class="eyebrow">Google · 2022–2023</p><h3>Google Data Analytics Certificate</h3><p>{t('Completed in 2023, followed by projects in Tableau and Python.', '2023 abgeschlossen, anschließend Projekte mit Tableau und Python.')}</p><span class="card-action">{t('Course details', 'Kursdetails')} ↗</span></div></a>
      <a class="course-card" href={url('courses/#research-methodology')}><span class="course-symbol" aria-hidden="true">✎</span><div><p class="eyebrow">Tata Institute of Social Sciences · 2005–2006</p><h3>{t('Post-Graduate Certificate in Research Methodology', 'Postgraduales Zertifikat in Forschungsmethodik')}</h3><p>{t('Completed at the Tata Institute of Social Sciences.', 'Abgeschlossen am Tata Institute of Social Sciences.')}</p><span class="card-action">{t('Course details', 'Kursdetails')} ↗</span></div></a>
    </div>
  </section>

  <section class="flow-section reading-section">
    <div><p class="handwritten">{t('On my bookshelf', 'In meinem Bücherregal')}</p><h2>{t('Favourite books', 'Lieblingsbücher')}</h2><p>{t('Books on creativity, history, and psychology.', 'Bücher über Kreativität, Geschichte und Psychologie.')}</p><a class="text-link" href={url('books/')}>{t('See the book list', 'Zur Bücherliste')} <span aria-hidden="true">↗</span></a></div>
    <div class="mini-books">{favouriteBooks.slice(0, 3).map((book, index) => <a class={`book-jacket ${book.theme}`} href={url(`books/#book-${index + 1}`)}><span class="book-top">{t('From my bookshelf', 'Aus meinem Bücherregal')}</span><h3>{book.title}</h3><span class="book-ornament" aria-hidden="true">{book.mark}</span><p>{book.note}</p></a>)}</div>
  </section>
</div>
