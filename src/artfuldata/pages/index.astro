---
import Layout from '../layouts/Layout.astro';
import { tableauProjects } from '../content/projects';
const base = import.meta.env.BASE_URL;
---
<Layout title="Data with a human story">
  <section class="hero home-hero">
    <p class="eyebrow">Data visualisation first</p>
    <h1>Making data meaningful.</h1>
    <p class="lead">I’m Monalisa. These dashboards are the work I want you to see first. Analysis sits just below; community and making are further along.</p>
    <div class="actions"><a class="button" href={`${base}visualisation/`}>Open the dashboards <span>↗</span></a></div>
  </section>
  <section>
    <div class="section-heading"><div><p class="eyebrow">Selected work</p><h2>Data visualisation</h2></div><a class="text-link" href={`${base}visualisation/`}>All three dashboards →</a></div>
    <div class="grid viz-tiles">{tableauProjects.map((project, index) => <a class="image-tile" href={`${base}visualisation/#project-${index + 1}`}><img src={`${base}images/${project.image}`} alt="" width="1200" height="900" /><span class="tile-copy"><h3>{project.title}</h3><p>{project.category}</p></span></a>)}</div>
  </section>
  <section>
    <div class="section-heading"><div><p class="eyebrow">In the same practice</p><h2>Data analytics</h2></div><a class="text-link" href={`${base}analytics/`}>All analysis →</a></div>
    <div class="grid analysis-tiles">
      <a class="image-tile" href={`${base}analytics/#notebooks`}><span class="tile-copy"><p class="eyebrow">Kaggle</p><h3>Notebooks</h3><p>Cyclistic capstone work and a nutrition diary.</p></span></a>
      <a class="image-tile" href={`${base}analytics/ceg/`}><img src={`${base}images/ceg/phase1-before-after.webp`} alt="" width="1416" height="483" /><span class="tile-copy"><p class="eyebrow">Case study</p><h3>CEG outreach experiment</h3><p>Flyer design, distribution, and website activity.</p></span></a>
      <a class="image-tile" href={`${base}analytics/#town-survey`}><img src={`${base}images/town-survey.webp`} alt="" width="680" height="880" /><span class="tile-copy"><p class="eyebrow">Report</p><h3>2025 town survey</h3><p>Survey tool, analysis, visualisation, and the published report.</p></span></a>
    </div>
  </section>
  <section>
    <div class="section-heading"><div><p class="eyebrow">Elsewhere</p><h2>Also making</h2></div></div>
    <div class="grid also-row">
      <a class="quiet-tile" href={`${base}community/`}><h3>Community</h3><p>CEG, the town survey, Oxfam, and other civic work.</p></a>
      <a class="quiet-tile" href={`${base}woodworking/`}><h3>Woodworking</h3><p>Self-taught furniture and storage, built by prototyping.</p></a>
    </div>
  </section>
</Layout>
