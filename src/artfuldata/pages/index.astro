---
import Layout from '../layouts/Layout.astro';
import { tableauProjects } from '../content/projects';
const base = import.meta.env.BASE_URL;
---
<Layout title="Data Analysis and Visualization">
  <section class="hero home-hero">
    <h1>Data Analysis and Visualization</h1>
    <p class="lead">Hi ! I’m Monalisa Hota, a data analyst and social researcher based in Düsseldorf. Here are some of my selected dashboards, analyses, and research projects.</p>
  </section>
  <section class="home-work">
    <div class="section-heading"><h2>Selected dashboards</h2><a class="text-link" href={`${base}visualisation/`}>All dashboards</a></div>
    <div class="grid viz-tiles">{tableauProjects.map((project, index) => <a class="image-tile" href={`${base}visualisation/#project-${index + 1}`}><img src={`${base}images/${project.image}`} alt={`Dashboard preview: ${project.title}`} width="736" height="454" /><span class="tile-copy"><h3>{project.title}</h3><p>{project.description}</p></span></a>)}</div>
  </section>
  <section>
    <div class="section-heading"><h2>Analysis and research</h2><a class="text-link" href={`${base}analytics/`}>All projects</a></div>
    <div class="project-index">
      <a href={`${base}analytics/ceg/`}><h3>CEG outreach experiment</h3><p>Flyer distribution and website activity in Arlington.</p><span>Case study</span></a>
      <a href={`${base}analytics/#town-survey`}><h3>Arlington town survey</h3><p>Survey development, analysis, and report writing.</p><span>Report</span></a>
      <a href={`${base}analytics/#notebooks`}><h3>Kaggle notebooks</h3><p>Cyclistic capstone analysis and a nutrition diary.</p><span>Kaggle</span></a>
    </div>
  </section>
</Layout>
