---
import Layout from '../../layouts/Layout.astro';
import Chart from '../../components/Chart.astro';
import CaseNavigation from '../../components/CaseNavigation.astro';
import Home from '../../components/Home.astro';
import Collection from '../../components/Collection.astro';
import NotebookList from '../../components/NotebookList.astro';
import { tableauProjects } from '../../content/projects';
import { germanProjects } from '../../content/languages';

export function getStaticPaths() {
  return [undefined, 'visualisation', 'analytics', 'analytics/ceg', 'about', 'community', 'woodworking', 'books', 'creativity', 'courses'].map(page => ({ params: { page } }));
}
const page = Astro.params.page ?? '';
const base = import.meta.env.BASE_URL;
const url = (path = '') => `${base}de/${path}`;
const projects = tableauProjects.map((project, index) => ({ ...project, ...germanProjects[index] }));
const titles: Record<string, string> = { '': 'Datenanalyse & Sozialforschung', visualisation: 'Datenvisualisierung', analytics: 'Datenanalyse und Forschung', 'analytics/ceg': 'CEG: Öffentlichkeitsarbeit', about: 'Über mich', community: 'Engagement', woodworking: 'Holzarbeiten', books: 'Lieblingsbücher', creativity: 'Problemlösen & Kreativität', courses: 'Kurse & Zertifikate' };
const experience = [
  ['2014–2015', 'Education Evangelist', 'Report Bee', 'Aufbau einer Online-Community rund um Geschichten von Lehrkräften; Auswahl von 15 veröffentlichten Geschichten aus 50 Einsendungen.'],
  ['2012–2013', 'Wissenschaftliche Mitarbeiterin', 'Akshara Foundation', 'Bereinigung, Kodierung und Analyse von Lernstandsdaten für eine randomisierte kontrollierte Studie sowie Veröffentlichung eines Berichts.'],
  ['2012', 'Freie Forscherin', 'Indian Social Institute', 'Konzeption und Durchführung einer qualitativen Pilotstudie zu den Wertvorstellungen von Kindern.'],
  ['2006–2007', 'Research Officer', 'Pratham Education Foundation', 'Entwicklung von Erhebungsinstrumenten, Schulung von Interviewenden und Erhebung, Bereinigung und Analyse landesweiter Lerndaten mit Stata.'],
  ['2003–2005', 'Program Officer', 'Association for Voluntary Action / Bachpan Bachao Andolan', 'Begleitung und Berichterstattung zu landesweiten Projekten gegen Kinderarbeit und Schuldknechtschaft.'],
];
---
<Layout title={titles[page]} description="Ausgewählte Datenvisualisierungen, Analysen und sozialwissenschaftliche Forschungsprojekte von Monalisa Hota in Düsseldorf.">
  {page === '' && <Home german />}
  {['books', 'creativity', 'courses'].includes(page) && <Collection page={page} german />}
  {page === 'visualisation' && <>
    <section class="page-intro"><h1>Datenvisualisierung</h1><p class="lead">Ausgewählte Tableau-Dashboards zu Verkehr und Gesellschaft.</p></section>
    <section class="project-list" aria-label="Ausgewählte Tableau-Projekte">{projects.map((project, index) => <article class="project split" id={`project-${index + 1}`}><a class="viz-preview" href={`https://public.tableau.com/views/${project.view}`} aria-label={`Dashboard ansehen: ${project.title}`}><img src={`${base}images/${project.image}`} alt={`Tableau-Dashboard: ${project.title}`} loading={index === 0 ? 'eager' : 'lazy'} width="736" height="454" /></a><div><p class="project-category">{project.category} · Tableau</p><h2>{project.title}</h2><p>{project.description}</p><a class="text-link" href={`https://public.tableau.com/views/${project.view}`}>Auf Tableau ansehen</a><details class="embed-panel"><summary>Interaktive Ansicht hier öffnen</summary><p class="small">Bereitgestellt von Tableau Public. Bei langen Ladezeiten nutzen Sie den Link oben.</p><iframe title={project.title} data-src={`https://public.tableau.com/views/${project.view}?:showVizHome=no&:embed=true&:toolbar=yes`} loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></details></div></article>)}</section>
    <section class="simple-section"><a class="text-link" href="https://public.tableau.com/app/profile/lisa.hota/vizzes">Weitere Projekte auf Tableau Public</a></section>
  </>}
  {page === 'analytics' && <>
    <section class="page-intro"><h1>Datenanalyse und Forschung</h1><p class="lead">Ausgewählte Notebooks, Berichte und Forschungsbeiträge.</p></section>
    <nav class="section-nav" aria-label="Analysebereiche"><a href="#notebooks">Notebooks</a><a href="#ceg">CEG</a><a href="#town-survey">Bürgerbefragung</a><a href="#aser">ASER</a><a href="#akshara">Akshara</a><a href="#isi">Wertestudie</a><a href="#thesis">Abschlussarbeit</a><a href="#report-bee">Report Bee</a></nav>
    <section id="notebooks"><div class="section-heading"><h2>Kaggle-Notebooks</h2><a class="text-link" href="https://www.kaggle.com/lisamlh/code">Kaggle-Profil</a></div><NotebookList german /></section>
    <section id="ceg" class="research split"><a class="research-preview" href={url('analytics/ceg/')} aria-label="CEG-Fallstudie lesen"><img src={`${base}images/ceg/phase1-before-after.webp`} alt="Website-Aktivität vor und nach der Öffentlichkeitsarbeit im Frühjahr" width="1416" height="483" loading="lazy" /></a><div><p class="project-category">Envision Arlington · 2024–2026</p><h2>CEG: Öffentlichkeitsarbeit</h2><p>Für die Civic Engagement Group gestaltete ich einen Flyer, plante seine Verteilung und analysierte die Website-Aktivität rund um drei Aktionszeiträume.</p><p>Die Fallstudie vergleicht einzelne Besucher und Website-Sitzungen und berücksichtigt saisonale Schwankungen und Einschränkungen bei der Verteilung.</p><a class="text-link" href={url('analytics/ceg/')}>Fallstudie lesen</a></div></section>
    <section id="town-survey" class="research split"><a class="research-preview report-preview" href={`${base}documents/2025-town-survey.pdf`} aria-label="Bericht zur Bürgerbefragung 2025 lesen"><img src={`${base}images/town-survey.webp`} alt="Titelseite des Berichts zur Bürgerbefragung in Arlington 2025" width="680" height="880" loading="lazy" /></a><div><p class="project-category">Envision Arlington · Bericht 2025</p><h2>Bürgerbefragung in Arlington</h2><p>Ich wirkte mit der Civic Engagement Group an der Fragebogenentwicklung, Analyse, Visualisierung und Berichterstellung mit.</p><p>Der Bericht fasst 3.268 Antworten zusammen, die vom 1. Januar bis zum 4. März 2024 erhoben wurden. Themen sind unter anderem Bürgerbeteiligung, Bildung, Bäume und fossile Brennstoffe.</p><p class="small">Die Zahlen stammen aus dem veröffentlichten Bericht. Er nennt die verwendeten Werkzeuge, einschließlich KI-Tools; mein Name ist darin nicht aufgeführt.</p><a class="text-link" href={`${base}documents/2025-town-survey.pdf`}>Bericht lesen · PDF</a></div></section>
    <section id="aser" class="research split"><a class="research-preview report-preview" href={`${base}documents/aser-2006.pdf`} aria-label="Annual Status of Education Report (Rural) 2006 lesen"><img src={`${base}images/aser-2006.webp`} alt="Titelseite des Annual Status of Education Report (Rural) 2006" width="995" height="1338" loading="lazy" /></a><div><p class="project-category">Pratham · 2006</p><h2>Annual Status of Education Report</h2><p>Annual Status of Education Report (Rural) 2006 ist ein gemeinsam erstellter landesweiter Bericht zur Bildung von Kindern in Indien, veröffentlicht von Pratham am 5. Januar 2007.</p><p>Meine Tätigkeit als Research Officer bei Pratham (2006–2007) umfasste die Entwicklung von Erhebungsinstrumenten, die Schulung von Interviewenden sowie Datenerhebung, Bereinigung und Analyse mit Stata.</p><a class="text-link" href={`${base}documents/aser-2006.pdf`}>ASER 2006 lesen · PDF</a></div></section>
    <section id="akshara" class="research split"><div class="research-preview"><img src={`${base}images/akshara.webp`} alt="Klassenzimmer und ein Erwachsener, der mit einem Kind Unterlagen durchsieht" width="1600" height="1058" loading="lazy" /></div><div><p class="project-category">Bildungsforschung · 2012–2013</p><h2>Akshara Foundation</h2><p>Als wissenschaftliche Mitarbeiterin bereinigte, kodierte und analysierte ich Lernstandsdaten für eine randomisierte kontrollierte Studie und veröffentlichte einen Bericht.</p><p class="small">Der Bericht ist auf dieser Website nicht verfügbar.</p></div></section>
    <section id="isi" class="research split"><a class="research-preview" href={`${base}documents/evolution-of-values.pdf`} aria-label="Pilotbericht zur Entwicklung von Wertvorstellungen lesen"><img src={`${base}images/isi-values.webp`} alt="Abbildung zu Piagets Stufen der kognitiven Entwicklung" width="616" height="427" loading="lazy" /></a><div><p class="project-category">Indian Social Institute · 2012</p><h2>Entwicklung von Wertvorstellungen</h2><p>Ich konzipierte und führte eine qualitative Pilotstudie mit 37 Kindern im Alter von 6 bis 15 Jahren an einer Schule in Bangalore durch. Geschichten über moralische Dilemmata dienten dazu, Integrität, Empathie, Gier sowie Vorstellungen von Geschlecht und Kaste zu untersuchen.</p><p class="small">Die explorative Studie an einer einzelnen Schule ist nicht statistisch repräsentativ. Die Abbildung zeigt Piagets Stufen der kognitiven Entwicklung. Quelle auf dem Bild: Joshua Seong, Verywell.</p><a class="text-link" href={`${base}documents/evolution-of-values.pdf`}>Pilotbericht lesen · PDF</a></div></section>
    <section id="thesis" class="research split"><a class="research-preview report-preview" href={`${base}documents/lse-dissertation.pdf`} aria-label="Abschlussarbeit lesen"><img src={`${base}images/lse-dissertation.webp`} alt="Cover von Bitter Chocolate: Child Sexual Abuse in India von Pinki Virani" width="224" height="355" loading="lazy" /></a><div><p class="project-category">London School of Economics · 2009</p><h2>Meldung von sexuellem Kindesmissbrauch in Indien</h2><p>Meine Masterarbeit verglich Meldeverfahren und Kinderschutzansätze in Indien, den USA und Großbritannien anhand von Literatur und Sekundärquellen.</p><p>Sie untersuchte Hindernisse bei der Offenlegung, die Rolle von Fachkräften und koordinierte Meldesysteme.</p><p class="small">Eingereicht im September 2009; die Analyse bezieht sich auf den damaligen politischen und rechtlichen Kontext. Das Bild ist das Cover von Pinki Viranis Bitter Chocolate, nicht das Cover der Abschlussarbeit.</p><a class="text-link" href={`${base}documents/lse-dissertation.pdf`}>Abschlussarbeit lesen · PDF</a></div></section>
    <section id="report-bee" class="research split"><div class="research-preview report-preview"><img src={`${base}images/report-bee.webp`} alt="Cover von Reflections, Band 1, April 2015, einer Report-Bee-Sammlung von Geschichten von Lehrkräften" width="1000" height="1403" loading="lazy" /></div><div><p class="project-category">Geschichten von Lehrkräften · 2014–2015</p><h2>Report Bee</h2><p>Als Education Evangelist baute ich eine Online-Community auf, in der Lehrkräfte ihre Erfahrungen teilen konnten. Aus 50 Einsendungen wählte ich 15 veröffentlichte Geschichten aus.</p><p class="small">Das Bild ist das Cover von Reflections, Band 1 (April 2015).</p></div></section>
  </>}
  {page === 'about' && <>
    <section class="hero split about-hero"><div><h1>Über mich</h1><p class="lead">Ich bin Monalisa Hota, Datenanalystin und Sozialforscherin in Düsseldorf.</p><p>Mein Hintergrund liegt in der Forschung zu Bildung, Kinderrechten und Sozialpolitik. Ich habe mit Organisationen in Indien an Fragebogenentwicklung, Datenerhebung, Analyse und Berichterstattung gearbeitet.</p><p>Nach einer beruflichen Pause absolvierte ich das Google Data Analytics Certificate und entwickelte Projekte mit Tableau und Python. Zuletzt wirkte ich an Öffentlichkeitsarbeit und Bürgerbefragungen in Arlington mit.</p><div class="actions"><a class="text-link" href={`${base}documents/monalisa-hota-cv.pdf`} target="_blank" rel="noopener noreferrer">Lebenslauf herunterladen</a><a class="text-link" href="mailto:monalisa.hota@gmail.com">E-Mail schreiben</a></div></div><figure class="portrait"><img src={`${base}images/portrait.webp`} alt="Monalisa Hota" width="600" height="600" /></figure></section>
    <section class="simple-section"><h2>Kenntnisse</h2><dl class="skills-list"><div><dt>Datenanalyse</dt><dd>Python, Pandas, Excel, Stata</dd></div><div><dt>Visualisierung</dt><dd>Tableau, Matplotlib, Seaborn</dd></div><div><dt>Forschung</dt><dd>Fragebogenentwicklung, qualitative und quantitative Methoden, Datenerhebung, Berichterstellung</dd></div><div><dt>Sprachen</dt><dd>Englisch und Hindi (fließend), Deutsch (B2), Oriya</dd></div></dl></section>
    <section><div class="section-heading"><h2>Berufserfahrung</h2></div><div class="experience-list">{experience.map(([date, role, organisation, summary], index) => <article id={['report-bee', 'akshara', 'isi', 'pratham', 'child-rights'][index]}><span class="small">{date}</span><div><h3>{role}</h3><p class="organisation">{organisation}</p><p>{summary}</p></div></article>)}</div></section>
    <section id="education" class="simple-section"><h2>Ausbildung</h2><div class="education-list"><article><h3>MSc Sozialpolitik und Entwicklung</h3><p>London School of Economics and Political Science · 2008–2009</p></article><article><h3>Postgraduales Zertifikat in Forschungsmethodik</h3><p>Tata Institute of Social Sciences · 2005–2006</p></article><article><h3>Master in Sozialer Arbeit</h3><p>Nagpur University · 2000–2002</p></article><article><h3>BSc Home Science</h3><p>Delhi University · 1997–2000</p></article><article><h3>Google Data Analytics Certificate</h3><p>2022–2023</p></article></div></section>
    <section class="simple-section"><h2>Außerhalb der Arbeit</h2><p class="personal-note">Ich beschäftige mich gern mit Holzarbeiten und fahre Ski. Außerdem habe ich die Unterstützung einer afghanischen Flüchtlingsfamilie mitorganisiert und repariere gespendete Uhren in einem Oxfam-Laden.</p><div class="actions"><a class="text-link" href={url('community/')}>Engagement</a><a class="text-link" href={url('woodworking/')}>Holzarbeiten</a></div></section>
  </>}
  {page === 'community' && <>
    <section class="page-intro"><h1>Engagement</h1><p class="lead">Ausgewählte ehrenamtliche Tätigkeiten und Beiträge zur Bürgerbeteiligung.</p></section>
    <section class="activity-list"><article id="civic"><h2>Civic Engagement Group</h2><p>Von 2024 bis 2026 arbeitete ich mit der Civic Engagement Group von Envision Arlington an Öffentlichkeitsarbeit und der jährlichen Bürgerbefragung.</p><div class="actions"><a class="text-link" href={url('analytics/ceg/')}>Fallstudie zur Öffentlichkeitsarbeit</a><a class="text-link" href={url('analytics/#town-survey')}>Bericht zur Bürgerbefragung</a></div></article><article id="refugee"><h2>Unterstützung einer Flüchtlingsfamilie</h2><p>2021–2022 half ich dabei, Ressourcen für eine afghanische Flüchtlingsfamilie zu koordinieren.</p></article><article id="oxfam"><h2>Oxfam</h2><p>Seit September 2026 repariere ich gespendete Uhren in einem Oxfam-Laden in Düsseldorf.</p></article></section>
  </>}
  {page === 'woodworking' && <>
    <section class="page-intro"><h1>Holzarbeiten</h1><p class="lead">Ich habe mir das Arbeiten mit Holz selbst beigebracht und zwischen 2018 und 2025 Möbel und Stauraumlösungen für mein Zuhause in Massachusetts gebaut.</p></section>
    <section class="simple-section"><h2>Möbel und Stauraum</h2><p>Ich baute mehr als acht Stauraumlösungen, darunter Schränke mit dreifach faltbaren Türen, ausziehbare Elemente und Bücherregale. Wo möglich verwendete ich Materialien wieder und erprobte Entwürfe mit selbst gebauten Prototypen.</p><p>Holzarbeiten sind ein persönliches Interesse neben meiner Daten- und Forschungsarbeit.</p></section>
  </>}
  {page === 'analytics/ceg' && <>
    <section class="page-intro"><h1>CEG: Öffentlichkeitsarbeit</h1><p class="lead">Ein Vergleich der Website-Aktivität rund um drei Aktionszeiträume in Arlington.</p></section>
    <CaseNavigation />
    <div class="case-meta" id="overview"><div><span class="small">Organisation</span><p>Envision Arlington<br />Civic Engagement Group</p></div><div><span class="small">Meine Beteiligung</span><p>Dezember 2024 – Mai 2026</p></div><div><span class="small">Mein Beitrag</span><p>Flyergestaltung, Verteilungsplanung und Datenanalyse</p></div></div>
    <section class="split"><div><h2>Hintergrund</h2></div><div><p>Die Civic Engagement Group vermittelt Einwohnern von Arlington Möglichkeiten, sich am Gemeindeleben zu beteiligen.</p><p>Ich leitete ein Experiment zur Öffentlichkeitsarbeit mit Flyergestaltung, Verteilung und Analyse der Website-Aktivität. Ich verglich einzelne Besucher und Sitzungen rund um aufeinanderfolgende Aktionszeiträume.</p></div></section>
    <section class="feature split"><div><h2>Der Flyer</h2><p>Ich gestaltete einen Flyer mit lokalen Motiven, einer Einladung zu einem Treffen und einem QR-Code zur Anmeldung auf der CEG-Website.</p><a class="text-link" href={`${base}documents/ceg-outreach-flyer.pdf`}>Flyer ansehen · PDF</a></div><a href={`${base}documents/ceg-outreach-flyer.pdf`}><img src={`${base}images/ceg/flyer.webp`} alt="CEG-Flyer mit einer Einladung zu einem Treffen in Arlington und QR-Code" width="1400" height="1082" loading="lazy" /></a></section>
    <section id="outreach-periods"><div class="section-heading"><h2>Aktionszeiträume</h2></div><div class="grid three timeline"><article><p class="small">18. April – 13. Mai 2025</p><h3>Frühjahr</h3><p>Die Website-Aktivität war nach der Aktion höher. Monatsdiagramme vergleichen den Zeitraum mit früheren Jahren.</p></article><article><p class="small">29. September – 18. Oktober 2025</p><h3>Herbst</h3><p>Die Verteilung blieb unvollständig, weil Flyer entfernt wurden. Am 18. Oktober wurden Postkarten versandt.</p></article><article><p class="small">13. Februar 2026</p><h3>Nur Postkarten</h3><p>Ein 30-Tage-Vergleich zeigt anschließend weniger Besucher. Frühere Spitzen im Februar und März liefern saisonalen Kontext.</p></article></div></section>
    <section class="evidence" id="website-activity"><h2>Website-Aktivität im Zeitverlauf</h2><p class="measure-note"><strong>Hinweise zu den Diagrammen:</strong> Balken zeigen einzelne Besucher, rote Kreuze zeigen Sitzungen, die wiederholte Besuche umfassen können. Die Achsen sind getrennt beschriftet. Die Originaldiagramme bleiben unverändert.</p><Chart image="all-months" title="Website-Aktivität im gesamten Zeitraum" alt="Monatliche Besucher und Sitzungen von Mai 2023 bis Mai 2026" caption="Im Februar und März war der Verkehr historisch höher, möglicherweise im Zusammenhang mit Gemeindewahlen. Der gesamte Verlauf liefert Kontext für die einzelnen Aktionen." /></section>
    <section class="evidence" id="spring-2025"><h2>Frühjahr 2025</h2><div class="finding"><strong>40 → 53</strong><p>Sitzungen vor und nach der Aktion.<br /><small>Das Diagramm verwendet 60-Tage-Zeiträume und schließt März aus dem vorherigen Zeitraum aus.</small></p></div><Chart image="phase1-before-after" title="Frühjahr: vorher und nachher" alt="Sitzungen steigen von 40 auf 53; auch die Besucherzahl nimmt zu" caption="Besucher und wiederholte Besuche nahmen nach dem 18. April 2025 zu. März wurde als saisonale Anpassung aus dem vorherigen Zeitraum ausgeschlossen." /><Chart image="phase1-months" title="Frühjahrsaktion im monatlichen Kontext" alt="Monatliche Website-Aktivität im Frühjahr im Jahresvergleich" caption="Der Vergleich mit früheren Jahren ergänzt die kürzere Vorher-Nachher-Betrachtung." /></section>
    <section class="evidence" id="autumn-2025"><h2>Herbst 2025</h2><Chart image="phase2-months" title="Herbst: unvollständige Verteilung" alt="Website-Aktivität von August bis Oktober mit Hinweisen auf entfernte Flyer" caption="Flyer wurden entfernt; einige blieben in der Robbins Library und in Geschäften. Am 18. Oktober wurden Postkarten versandt. Das Diagramm zeigt keine erkennbare Verbesserung der Website-Aktivität in dieser Phase." /></section>
    <section class="evidence" id="february-2026"><h2>Februar 2026</h2><div class="finding"><strong>30 → 18</strong><p>Einzelne Besucher vor und nach dem Postkartenversand.<br /><small>Verglichen werden 30-Tage-Zeiträume rund um den 13. Februar 2026.</small></p></div><Chart image="phase3-before-after" title="Postkarten: vorher und nachher" alt="Die Besucherzahl sinkt nach dem Postkartenversand von 30 auf 18" caption="Nach der Aktion gab es weniger Besucher und Sitzungen, anders als im Frühjahrsvergleich." /><Chart image="phase3-months" title="Postkartenaktion im saisonalen Kontext" alt="Website-Aktivität von Januar bis März im Jahresvergleich" caption="Zu dieser Jahreszeit war der Verkehr historisch höher. Der Monatswert für Februar und der 30-Tage-Wert nach der Aktion beziehen sich auf unterschiedliche Zeiträume und sind nicht dieselbe Kennzahl." /></section>
    <section class="reflection split" id="limitations"><div><h2>Einschränkungen und nächste Schritte</h2></div><div><p>Saisonale Schwankungen, unvollständige Verteilung und unterschiedliche Vergleichszeiträume beeinflussen die Interpretation. Diese beschreibenden Vergleiche belegen keinen kausalen Effekt und messen nicht die Teilnahme an Treffen.</p><p>Eine weitere Runde könnte Verteilungszahlen, aktionsbezogene QR-Links und Anmeldungen zusätzlich zur Website-Aktivität erfassen.</p><p class="small">Quelle: der CEG-Flyer und sechs kommentierte Diagramme. Es lag kein zugrunde liegender Datensatz vor; die genannten Zahlen stammen aus den Diagrammbeschriftungen.</p></div></section>
    <dialog class="chart-dialog" aria-labelledby="chart-title"><div class="dialog-header"><h2 id="chart-title">Diagrammdetail</h2><button type="button" class="close-dialog" autofocus>Schließen <span aria-hidden="true">×</span></button></div><div class="dialog-image"><img alt="" /></div><p class="small">Auf kleinen Bildschirmen horizontal scrollen, um das Originaldiagramm zu lesen.</p></dialog>
  </>}
  <script>
    document.querySelectorAll<HTMLDetailsElement>('.embed-panel').forEach(panel => {
      panel.addEventListener('toggle', () => {
        const frame = panel.querySelector('iframe');
        if (panel.open && frame?.dataset.src && !frame.hasAttribute('src')) frame.src = frame.dataset.src;
      });
    });
    const dialog = document.querySelector<HTMLDialogElement>('.chart-dialog');
    document.querySelectorAll<HTMLAnchorElement>('.chart-zoom').forEach(link => {
      link.addEventListener('click', event => {
        const image = dialog?.querySelector('img');
        const title = dialog?.querySelector('#chart-title');
        if (!dialog || !image || !title || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        image.src = link.href;
        image.alt = link.querySelector('img')?.alt ?? '';
        title.textContent = link.dataset.caption ?? 'Diagrammdetail';
        dialog.showModal();
      });
    });
    dialog?.querySelector('button')?.addEventListener('click', () => dialog.close());
    dialog?.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
  </script>
</Layout>
