---
import Layout from '../layouts/Layout.astro';
import { notebooks } from '../content/projects';
const base = import.meta.env.BASE_URL;
---
<Layout title="Data Analysis and Research" description="Kaggle notebooks, education research, social policy, and civic research projects by Monalisa Hota.">
  <section class="page-intro"><h1>Data Analysis and Research</h1><p class="lead">Selected notebooks, reports, and research contributions.</p></section>
  <nav class="section-nav" aria-label="Analytics sections"><a href="#notebooks">Notebooks</a><a href="#ceg">CEG outreach</a><a href="#town-survey">Town survey</a><a href="#aser">ASER</a><a href="#akshara">Akshara</a><a href="#isi">Values study</a><a href="#thesis">Dissertation</a><a href="#report-bee">Report Bee</a></nav>
  <section id="notebooks"><div class="section-heading"><h2>Kaggle notebooks</h2><a class="text-link" href="https://www.kaggle.com/lisamlh/code">Kaggle profile</a></div><div class="project-index">{notebooks.map(notebook => <a href={`https://www.kaggle.com/code/lisamlh/${notebook.slug}`}><h3>{notebook.title}</h3><p>{notebook.description}</p><span>Read notebook</span></a>)}</div></section>
  <section id="ceg" class="research split"><a class="research-preview" href={`${base}analytics/ceg/`} aria-label="Read the CEG outreach case study"><img src={`${base}images/ceg/phase1-before-after.webp`} alt="Chart comparing website activity before and after spring outreach" width="1416" height="483" loading="lazy" /></a><div><p class="project-category">Envision Arlington · 2024–2026</p><h2>CEG outreach experiment</h2><p>I designed a flyer, planned its distribution, and analysed website activity around three outreach periods for the Civic Engagement Group.</p><p>The case study compares unique visitors and site sessions, with notes on seasonality and distribution limits.</p><a class="text-link" href={`${base}analytics/ceg/`}>Read the case study</a></div></section>
  <section id="town-survey" class="research split"><a class="research-preview report-preview" href={`${base}documents/2025-town-survey.pdf`} aria-label="Read the 2025 Arlington town survey report"><img src={`${base}images/town-survey.webp`} alt="Cover of the 2025 Arlington annual town survey report" width="680" height="880" loading="lazy" /></a><div><p class="project-category">Envision Arlington · 2025 report</p><h2>Arlington town survey</h2><p>I contributed to survey tool development, analysis, visualization, and report writing with the Civic Engagement Group.</p><p>The report summarises 3,268 responses collected from 1 January to 4 March 2024, on topics including civic engagement, education, trees, and fossil fuels.</p><p class="small">Figures are taken from the published report. It lists the tools used, including AI tools; my name is not printed in it.</p><a class="text-link" href={`${base}documents/2025-town-survey.pdf`}>Read the report · PDF</a></div></section>
  <section id="aser" class="research text-research"><p class="project-category">Pratham · 2005</p><h2>Annual Status of Education Report</h2><p>I contributed data analytics work to ASER 2005, a collaborative national report on children’s education in India.</p><p>My later Research Officer role at Pratham (2006–2007) included survey development, surveyor training, data collection, cleaning, and analysis using Stata.</p><a class="text-link" href="https://img.asercentre.org/docs/Publications/ASER%20Reports/ASER_2005/aserfullreport2005.pdf">Read ASER 2005 · PDF</a></section>
  <section id="akshara" class="research text-research"><p class="project-category">Education research · 2012–2013</p><h2>Akshara Foundation</h2><p>As a Research Associate, I cleaned, coded, and analysed student learning data for a randomised control trial and published a report.</p><p class="small">The report isn’t available on this site.</p></section>
  <section id="isi" class="research text-research"><p class="project-category">Indian Social Institute · 2012</p><h2>Evolution of Values</h2><p>I designed and conducted a qualitative pilot study with 37 children aged 6–15 at a school in Bangalore. Moral-dilemma stories were used to explore integrity, empathy, greed, and perceptions of gender and caste.</p><p class="small">This was an exploratory, single-school study, not a statistically representative sample.</p><a class="text-link" href={`${base}documents/evolution-of-values.pdf`}>Read the pilot report · PDF</a></section>
  <section id="thesis" class="research text-research"><p class="project-category">London School of Economics · 2009</p><h2>Reporting Child Sexual Abuse in India</h2><p>My master’s dissertation compared reporting and child-protection approaches in India, the United States, and the United Kingdom, using literature and secondary sources.</p><p>It examined barriers to disclosure, the role of professionals, and coordinated reporting systems.</p><p class="small">Submitted September 2009; the analysis reflects the policy and legal context at that time.</p><a class="text-link" href={`${base}documents/lse-dissertation.pdf`}>Read the dissertation · PDF</a></section>
  <section id="report-bee" class="research text-research"><p class="project-category">Teachers’ stories · 2014–2015</p><h2>Report Bee</h2><p>As an Education Evangelist, I built an online community for teachers to share their experiences. I curated 15 published stories from 50 submissions.</p></section>
</Layout>
