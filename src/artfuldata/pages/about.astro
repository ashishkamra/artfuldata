---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
const experience = [
  ['2014–2015', 'Education Evangelist', 'Report Bee', 'Built an online community around teachers’ stories, collaborating with authors and curating 15 published stories from 50 submissions.'],
  ['2012–2013', 'Research Associate', 'Akshara Foundation', 'Cleaned, coded, and analysed learning-level data for a randomised control trial and published an official report.'],
  ['2012', 'Independent Researcher', 'Indian Social Institute', 'Designed and executed a qualitative pilot study on children’s values, analysing responses and sharing the report.'],
  ['2006–2007', 'Research Officer', 'Pratham Education Foundation', 'Developed survey tools, trained surveyors, and collected, cleaned, and analysed national learning data using Stata.'],
  ['2003–2005', 'Program Officer', 'Association for Voluntary Action / Bachpan Bachao Andolan', 'Monitored and reported on national projects addressing child and bonded labour.'],
];
---
<Layout title="About & Contact">
  <section class="hero split about-hero"><div><p class="eyebrow">HELLO, I’M MONALISA</p><h1>A researcher’s mind.<br /><em>A maker’s imagination.</em></h1><p class="lead">I’m a data analyst and social researcher who finds energy in learning, solving problems, and making things work better for people.</p><p>Based in Düsseldorf, with a journey that spans social-impact organisations, international relocations, self-directed projects, and creative data exploration.</p><div class="actions"><a class="button" href="mailto:monalisa.hota@gmail.com">Say hello ↗</a><a class="text-link" href={`${base}documents/monalisa-hota-cv.pdf`}>Download my CV ↓</a></div></div><figure class="portrait"><img src={`${base}images/portrait.webp`} alt="Monalisa Hota" width="600" height="600" /><figcaption>Curiosity is the thread that connects it all.</figcaption></figure></section>
  <section class="split"><div><p class="eyebrow">MY APPROACH</p><h2>Question.<br />Create.<br /><em>Refine.</em></h2></div><div><p class="lead">My foundation is social research: listening closely, asking useful questions, and working carefully with evidence.</p><p>Over 7+ years in impact-driven NGOs, I worked on education, child rights, and community research. An 11-year career pause became a period of autonomous projects and self-directed learning, building creative problem-solving skills along the way.</p><p>I’ve since pursued a Google Data Analytics certificate, Tableau projects beyond standard chart forms, and Python analytics with Pandas, Matplotlib, and Seaborn.</p><p>The same mindset appears in my design-build projects: I taught myself to build wooden furniture and created over eight inventive storage solutions, learning through prototypes and iteration.</p></div></section>
  <section><div class="section-heading"><div><p class="eyebrow">WHAT I BRING</p><h2>A connected <em>toolkit.</em></h2></div></div><div class="grid three"><article class="work-card"><p class="eyebrow">DATA & VISUALS</p><h3>From raw data<br />to clear stories.</h3><p>Tableau Public · Python · Pandas · Matplotlib · Seaborn · Excel · MS Office</p></article><article class="work-card"><p class="eyebrow">SOCIAL RESEARCH</p><h3>Methods that start<br />with people.</h3><p>Study design · Survey tools · Qualitative and quantitative research · Data collection, processing, and analysis</p></article><article class="work-card"><p class="eyebrow">CREATIVE PRACTICE</p><h3>Resourceful.<br />Practical. Empathetic.</h3><p>Human-centred design thinking · Prototyping · Iteration · Creative problem-solving</p></article></div></section>
  <section><div class="section-heading"><div><p class="eyebrow">PROFESSIONAL FOUNDATIONS</p><h2>Work that shaped<br /><em>my perspective.</em></h2></div><a class="text-link" href={`${base}documents/monalisa-hota-cv.pdf`}>Full experience in my CV ↗</a></div><div class="experience-list">{experience.map(([date, role, organisation, summary]) => <article><span class="eyebrow">{date}</span><div><h3>{role}</h3><p class="organisation">{organisation}</p><p>{summary}</p></div></article>)}</div></section>
  <section class="split"><div><p class="eyebrow">LEARNING, ALWAYS</p><h2>Education &<br /><em>exploration.</em></h2></div><div class="education-list"><article><h3>MSc Social Policy and Development</h3><p>London School of Economics and Political Science · 2008–2009</p></article><article><h3>Post-Graduate Certificate in Research Methodology</h3><p>Tata Institute of Social Sciences · 2005–2006</p></article><article><h3>Master of Social Work</h3><p>Nagpur University · Family and Child Welfare · 2000–2002</p></article><article><h3>BSc Home Science</h3><p>Delhi University · Child Welfare · 1997–2000</p></article><article><h3>Google Data Analytics Certificate</h3><p>With capstone project · 2022–2023</p></article><p class="small">Further learning: human-centred design workshops, behavioural economics and mindfulness, creativity and innovation courses, and Toastmasters’ Triple Crown Award.</p></div></section>
  <section class="banner community"><div><p class="eyebrow">BEYOND THE DESK</p><h2>Making a <em>contribution.</em></h2><p>Civic engagement and town survey work in Arlington (2024–2026). Resource coordination for resettling an Afghan refugee family (2021–2022). Repairing donated watches at an Oxfam shop in Düsseldorf (from September 2026).</p><p>Outside work: learning, carpentry, problem-solving, and skiing.</p><p class="small">Languages: fluent English and Hindi · B2 German · Oriya</p></div><a class="button" href={`${base}ceg/`}>Explore the CEG experiment ↗</a></section>
  <section class="contact-section" id="contact"><p class="eyebrow">LET’S CONNECT</p><h2>Have a question?<br /><em>Let’s start a conversation.</em></h2><p>For opportunities, collaborations, or a conversation about data and design.</p><a class="button" href="mailto:monalisa.hota@gmail.com">Email Monalisa ↗</a><a class="text-link" href="https://www.linkedin.com/in/youdontfoolme/">Connect on LinkedIn ↗</a></section>
</Layout>
