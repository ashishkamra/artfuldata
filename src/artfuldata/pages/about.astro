---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
const experience = [
  ['2014–2015', 'Education Evangelist', 'Report Bee', 'Built an online community around teachers’ stories and curated 15 published stories from 50 submissions.'],
  ['2012–2013', 'Research Associate', 'Akshara Foundation', 'Cleaned, coded, and analysed learning-level data for a randomised control trial and published a report.'],
  ['2012', 'Independent Researcher', 'Indian Social Institute', 'Designed and conducted a qualitative pilot study on children’s values.'],
  ['2006–2007', 'Research Officer', 'Pratham Education Foundation', 'Developed survey tools, trained surveyors, and collected, cleaned, and analysed national learning data using Stata.'],
  ['2003–2005', 'Program Officer', 'Association for Voluntary Action / Bachpan Bachao Andolan', 'Monitored and reported on national projects addressing child and bonded labour.'],
];
---
<Layout title="About">
  <section class="hero split about-hero">
    <div><h1>About me</h1><p class="lead">I’m Monalisa Hota, a data analyst and social researcher based in Düsseldorf.</p><p>My background is in education, child rights, and social policy research. I’ve worked on survey design, data collection, analysis, and reporting with organisations in India.</p><p>After a career break, I completed the Google Data Analytics Certificate and developed projects using Tableau and Python. More recently, I contributed to civic outreach and town survey work in Arlington.</p><div class="actions"><a class="text-link" href={`${base}documents/monalisa-hota-cv.pdf`} target="_blank" rel="noopener noreferrer">Download CV</a><a class="text-link" href="mailto:monalisa.hota@gmail.com">Email me</a></div></div>
    <figure class="portrait"><img src={`${base}images/portrait.webp`} alt="Monalisa Hota" width="600" height="600" /></figure>
  </section>
  <section class="simple-section"><h2>Skills</h2><dl class="skills-list"><div><dt>Data analysis</dt><dd>Python, Pandas, Excel, Stata</dd></div><div><dt>Visualization</dt><dd>Tableau, Matplotlib, Seaborn</dd></div><div><dt>Research</dt><dd>Survey design, qualitative and quantitative methods, data collection, report writing</dd></div><div><dt>Languages</dt><dd>English and Hindi (fluent), German (B2), Oriya</dd></div></dl></section>
  <section><div class="section-heading"><h2>Selected experience</h2></div><div class="experience-list">{experience.map(([date, role, organisation, summary], index) => <article id={['report-bee', 'akshara', 'isi', 'pratham', 'child-rights'][index]}><span class="small">{date}</span><div><h3>{role}</h3><p class="organisation">{organisation}</p><p>{summary}</p></div></article>)}</div></section>
  <section id="education" class="simple-section"><h2>Education</h2><div class="education-list"><article><h3>MSc Social Policy and Development</h3><p>London School of Economics and Political Science · 2008–2009</p></article><article><h3>Post-Graduate Certificate in Research Methodology</h3><p>Tata Institute of Social Sciences · 2005–2006</p></article><article><h3>Master of Social Work</h3><p>Nagpur University · 2000–2002</p></article><article><h3>BSc Home Science</h3><p>Delhi University · 1997–2000</p></article><article><h3>Google Data Analytics Certificate</h3><p>2022–2023</p></article></div></section>
  <section class="simple-section"><h2>Outside work</h2><p class="personal-note">I enjoy woodworking and skiing. I’ve also helped coordinate resources for an Afghan refugee family and repair donated watches at an Oxfam shop.</p><div class="actions"><a class="text-link" href={`${base}community/`}>Community work</a><a class="text-link" href={`${base}woodworking/`}>Woodworking</a></div></section>
</Layout>
