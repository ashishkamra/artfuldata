---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="Community">
  <section class="page-intro"><h1>Community work</h1><p class="lead">Selected volunteering and civic research activities.</p></section>
  <section class="activity-list">
    <article><h2>Civic Engagement Group</h2><p>I worked on outreach and the annual town survey with Envision Arlington’s Civic Engagement Group, from 2024 to 2026.</p><div class="actions"><a class="text-link" href={`${base}analytics/ceg/`}>Outreach case study</a><a class="text-link" href={`${base}analytics/#town-survey`}>Town survey report</a></div></article>
    <article><h2>Refugee support</h2><p>I helped coordinate resources for an Afghan refugee family in 2021–2022.</p></article>
    <article><h2>Oxfam</h2><p>I repair donated watches at an Oxfam shop in Düsseldorf, from September 2026.</p></article>
  </section>
</Layout>
