---
import Layout from '../layouts/Layout.astro';
import DietDiary from '../components/DietDiary.astro';
import { tableauProjects } from '../content/projects';
const base = import.meta.env.BASE_URL;
---
<Layout title="Data Visualization" description="Nutrition diary charts and selected Tableau dashboards by Monalisa Hota, covering train delays in Germany and interpersonal trust in America.">
  <section class="page-intro"><h1>Data Visualization</h1><p class="lead">Nutrition diary charts and selected Tableau dashboards on transport and society.</p></section>
  <DietDiary />
  <section class="project-list" aria-label="Selected Tableau projects">{tableauProjects.map((project, index) => <article class="project split" id={project.id}><a class="viz-preview" href={`https://public.tableau.com/views/${project.view}`} aria-label={`View dashboard: ${project.title}`}><img src={`${base}images/${project.image}`} alt={`Tableau dashboard preview: ${project.title}`} loading={index === 0 ? 'eager' : 'lazy'} width="736" height="454" /></a><div><p class="project-category">{project.category} · Tableau</p><h2>{project.title}</h2><p>{project.description}</p><a class="text-link" href={`https://public.tableau.com/views/${project.view}`}>View on Tableau</a><details class="embed-panel"><summary>Open interactive view here</summary><p class="small">Hosted by Tableau Public. If it is slow to load, use the link above.</p><iframe title={project.title} data-src={`https://public.tableau.com/views/${project.view}?:showVizHome=no&:embed=true&:toolbar=yes`} loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></details></div></article>)}</section>
  <section class="simple-section"><a class="text-link" href="https://public.tableau.com/app/profile/lisa.hota/vizzes">More projects on Tableau Public</a></section>
  <script>
    document.querySelectorAll<HTMLDetailsElement>('.embed-panel').forEach(panel => {
      panel.addEventListener('toggle', () => {
        const frame = panel.querySelector('iframe');
        if (panel.open && frame?.dataset.src && !frame.hasAttribute('src')) frame.src = frame.dataset.src;
      });
    });
  </script>
</Layout>
