---
import '../styles/global.css';
const { title, description = 'Monalisa Hota: data analytics, creative data visualisation, and social research. Explore projects that connect evidence with human experience.' } = Astro.props;
const base = import.meta.env.BASE_URL;
const url = (path = '') => `${base}${path}`;
const navigation = [['', 'Home'], ['visualisation/', 'Data Visualisation'], ['analytics/', 'Data Analytics'], ['ceg/', 'CEG Experiment'], ['about/', 'About & Contact']];
const current = Astro.url.pathname.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Monalisa Hota</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <meta property="og:title" content={`${title} · Monalisa Hota`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={new URL(url('images/social-card.png'), Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="masthead"><a class="brand" href={url()}><span class="brand-mark" aria-hidden="true">m<span>.</span></span><span>Monalisa Hota<small>THE ARTFUL DATA PORTFOLIO</small></span></a><a class="hello" href="mailto:monalisa.hota@gmail.com">Let’s connect <span aria-hidden="true">↗</span></a></div>
      <nav aria-label="Main navigation">{navigation.map(([path, label]) => <a href={url(path)} aria-current={current === url(path).replace(/\/$/, '') ? 'page' : undefined}>{label}</a>)}</nav>
    </header>
    <main id="main"><slot /></main>
    <footer><div><span class="eyebrow">GOOD QUESTIONS. THOUGHTFUL ANSWERS.</span><h2>Let’s make something<br /><em>meaningful.</em></h2><a class="text-link" href="mailto:monalisa.hota@gmail.com">monalisa.hota@gmail.com ↗</a></div><div class="footer-links"><a href="https://public.tableau.com/app/profile/lisa.hota/vizzes">Tableau Public ↗</a><a href="https://www.kaggle.com/lisamlh/code">Kaggle ↗</a><a href="https://www.linkedin.com/in/youdontfoolme/">LinkedIn ↗</a><small>Monalisa Hota · Düsseldorf, Germany<br />Data, design & a little curiosity.</small></div></footer>
  </body>
</html>
