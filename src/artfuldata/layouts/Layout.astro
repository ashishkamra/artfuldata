---
import '../styles/global.css';
import '../styles/pages.css';
import { workCategories } from '../content/site';
import LanguagePosition from '../components/LanguagePosition.astro';
const { title, description = 'Selected data visualization, analysis, and social research projects by Monalisa Hota, based in Düsseldorf.' } = Astro.props;
const base = import.meta.env.BASE_URL;
const relativePath = Astro.url.pathname.slice(base.length).replace(/^\/+/, '');
const german = relativePath === 'de' || relativePath.startsWith('de/');
const pagePath = (german ? relativePath.replace(/^de\/?/, '') : relativePath).replace(/\/$/, '');
const language = german ? 'de' : 'en';
const url = (path = '') => `${base}${german ? 'de/' : ''}${path}`;
const englishUrl = `${base}${pagePath ? `${pagePath}/` : ''}`;
const germanUrl = `${base}de/${pagePath ? `${pagePath}/` : ''}`;
const workPage = ['visualisation', 'analytics', 'analytics/ceg', 'community', 'woodworking', 'creativity', 'courses'].includes(pagePath);
const pageTone = { visualisation: 'viz', analytics: 'research', 'analytics/ceg': 'research', community: 'community', woodworking: 'making', creativity: 'making', courses: 'courses', books: 'books', about: 'about' }[pagePath];
const backUrl = url(pagePath === 'analytics/ceg' ? 'analytics/' : '');
---
<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <LanguagePosition />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Monalisa Hota</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(englishUrl, Astro.site)} />
    <link rel="alternate" hreflang="de" href={new URL(germanUrl, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta property="og:title" content={`${title} · Monalisa Hota`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={new URL(`${base}images/social-card.png`, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">{german ? 'Zum Inhalt springen' : 'Skip to content'}</a>
    <header class="site-header">
      <a class="brand" href={url()}>Monalisa Hota</a>
      <nav class="primary-nav" aria-label={german ? 'Hauptnavigation' : 'Main navigation'}>
        <a href={url()} aria-current={pagePath === '' ? 'page' : undefined}>{german ? 'Start' : 'Home'}</a>
        <details class="work-menu"><summary aria-current={workPage ? 'true' : undefined}>{german ? 'Arbeit' : 'Work'} <span aria-hidden="true">⌄</span></summary><div class="work-dropdown"><a href={url('#work')}>{german ? 'Alle Bereiche' : 'All work'} <span aria-hidden="true">↘</span></a>{workCategories.map(category => <a href={url(category.path)}>{german ? category.de : category.en}</a>)}</div></details>
        <a href={`${base}documents/monalisa-hota-cv.pdf`} aria-label={german ? 'Lebenslauf · PDF' : 'CV · PDF'}>{german ? 'Lebenslauf' : 'CV'}</a>
        <a href={url('books/')} aria-current={pagePath === 'books' ? 'page' : undefined}>{german ? 'Bücher' : 'Books'}<span class="nav-aside">{german ? '(Favoriten)' : '(fav)'}</span></a>
        <a href="#contact">{german ? 'Kontakt' : 'Contact'}</a>
      </nav>
      <nav class="language-switch" aria-label={german ? 'Sprache wählen' : 'Choose language'}><a href={englishUrl} lang="en" hreflang="en" aria-label="English" aria-current={!german ? 'page' : undefined}>EN</a><a href={germanUrl} lang="de" hreflang="de" aria-label="Deutsch" aria-current={german ? 'page' : undefined}>DE</a></nav>
    </header>
    <main id="main" class:list={{ 'section-dividers': pagePath === 'analytics', 'case-study': pagePath === 'analytics/ceg', 'inner-page': Boolean(pagePath), [`tone-${pageTone}`]: pageTone }}>{pagePath && <a class="back-link" href={backUrl} data-base={base} aria-label={german ? 'Zurück zur vorherigen Seite' : 'Back to previous page'}><span aria-hidden="true">←</span> {german ? 'Zurück' : 'Back'}</a>}<slot /></main>
    <footer id="contact"><div><p class="footer-greeting">{german ? 'Kontakt' : 'Contact'}</p><a href="mailto:monalisa.hota@gmail.com">monalisa.hota@gmail.com <span aria-hidden="true">↗</span></a><small>{german ? 'Düsseldorf, Deutschland' : 'Düsseldorf, Germany'}</small>{german && <small>Verlinkte Dokumente und Dashboards bleiben in ihrer Originalsprache.</small>}</div><div class="footer-links"><a href={url('about/')}>{german ? 'Über mich' : 'About me'}</a><a href="https://www.linkedin.com/in/youdontfoolme/">LinkedIn</a><a href="https://public.tableau.com/app/profile/lisa.hota/vizzes">Tableau</a><a href="https://www.kaggle.com/lisamlh/code">Kaggle</a></div></footer>
    <script>
      const workMenu = document.querySelector<HTMLDetailsElement>('.work-menu');
      document.addEventListener('click', event => {
        if (event.target instanceof Node && workMenu && !workMenu.contains(event.target)) workMenu.open = false;
      });
      workMenu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { workMenu.open = false; }));
      document.addEventListener('keydown', event => {
        if (event.key === 'Escape' && workMenu?.open) {
          workMenu.open = false;
          workMenu.querySelector('summary')?.focus();
        }
      });
      const updateLanguageLinks = () => document.querySelectorAll<HTMLAnchorElement>('.language-switch a').forEach(link => {
        link.hash = window.location.hash;
      });
      updateLanguageLinks();
      window.addEventListener('hashchange', updateLanguageLinks);
      const back = document.querySelector<HTMLAnchorElement>('.back-link');
      if (back && document.referrer) {
        const previous = new URL(document.referrer);
        const base = back.dataset.base ?? '/';
        const path = (url: URL) => url.pathname.slice(base.length).replace(/^de\/?/, '').replace(/\/$/, '');
        if (previous.origin === location.origin && previous.pathname.startsWith(base) && path(previous) !== path(new URL(location.href))) {
          back.href = previous.href;
          back.addEventListener('click', event => {
            if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey || event.button !== 0 || history.length < 2) return;
            event.preventDefault();
            history.back();
          });
        }
      }
    </script>
  </body>
</html>
